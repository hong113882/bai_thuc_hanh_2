#include <stdio.h>
#include <stdlib.h>
#include <string.h>
struct SinhVien {
    char ma[20];
    char hoTen[30];
    float d1, d2, d3;
};
int main() {
    int n;
    printf("Nhap so luong sinh vien: ");
    scanf("%d", &n);
    struct SinhVien *ds = (struct SinhVien *)malloc(n * sizeof(struct SinhVien));
    for (int i = 0; i < n; i++) {
        printf("\nSinh vien thu %d:\n", i + 1);
        printf("  Ma SV: ");
        scanf("%s", ds[i].ma);
        while (getchar() != '\n');
        printf("  Ho ten: ");
        fgets(ds[i].hoTen, sizeof(ds[i].hoTen), stdin);
        ds[i].hoTen[strcspn(ds[i].hoTen, "\n")] = 0;
        printf("  3 diem: ");
        scanf("%f %f %f", &ds[i].d1, &ds[i].d2, &ds[i].d3);
    }
    printf("\nDANH SACH SINH VIEN:\n");
    for (int i = 0; i < n; i++) {
        printf("%d. Ma: %s | Ten: %s | Diem: %.1f, %.1f, %.1f\n", 
               i + 1, ds[i].ma, ds[i].hoTen, ds[i].d1, ds[i].d2, ds[i].d3);
    }
    free(ds);
    return 0;
}
