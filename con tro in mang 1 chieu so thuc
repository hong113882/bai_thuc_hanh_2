#include <stdio.h>
#include <stdlib.h>
int main() {
    int n;
    printf("Nhap so luong phan tu n: ");
    scanf("%d", &n);
    float *p = (float *)malloc(n * sizeof(float));
    if (p == NULL) {
        printf("Khong du bo nho!\n");
        return 1;
    }
    printf("Nhap cac phan tu:\n");
    for (int i = 0; i < n; i++) {
        scanf("%f", p + i); 
    }
    printf("Mang vua nhap: ");
    for (int i = 0; i < n; i++) {
        printf("%.2f  ", *(p + i));
    }
    free(p);
    return 0;
}
